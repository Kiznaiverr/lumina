# Lumina environment configuration
# Copy this file to .env and adjust values as needed.

# Directory where model files are stored.
# Priority: LUMINA_MODEL_DIR > saved location (Settings → Models) > userData/models.
# In a source checkout, point this at the repo's models/ folder.
LUMINA_MODEL_DIR=D:\ngoding\lumina\models

# Python backend port (must match PYTHON_PORT in src/main/backend.ts)
LUMINA_BACKEND_PORT=8765

# Backend log verbosity: debug | info | warn | error (default: info)
LUMINA_LOG_LEVEL=info
