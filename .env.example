# Lumina environment configuration
# Copy this file to .env and adjust values as needed.

# Directory where the ONNX detection model is stored.
# Default: <repo>/models
LUMINA_MODEL_DIR=D:\ngoding\lumina\models

# Python backend port (must match PYTHON_PORT in src/electron/main/backend.ts)
LUMINA_BACKEND_PORT=8765

# Backend log verbosity: debug | info | warn | error (default: info)
LUMINA_LOG_LEVEL=info
